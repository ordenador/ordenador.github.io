{
  "name": "resume",
  "packageManager": "pnpm@11.9.0",
  "version": "1.0.0",
  "type": "module",
  "description": "Mario Faúndez's Resume",
  "main": "src/index.js",
  "scripts": {
    "start": "vite",
    "build": "vite build && vite build --ssr entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "lint": "eslint src entry-server.jsx site.config.mjs scripts/prerender.mjs vite.config.js",
    "lint:fix": "eslint src entry-server.jsx site.config.mjs scripts/prerender.mjs vite.config.js --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,json,md}\"",
    "check:site": "uv run python scripts/check_site.py"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "postcss": "^8.5.16",
    "prettier": "^3.9.4",
    "tailwindcss": "^4.3.2",
    "vite": "^8.1.3"
  }
}
